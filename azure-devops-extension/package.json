{
  "name": "spec-kit-azure-devops-extension",
  "version": "1.0.0",
  "description": "Azure DevOps extension for Spec Kit - Spec-Driven Development",
  "main": "index.js",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "test": "jest",
    "test:local": "node scripts/test-local.js",
    "lint": "eslint \"src/**/*.ts\"",
    "package": "npx tfx extension create --manifest-globs vss-extension.json",
    "package:dev": "npx tfx extension create --manifest-globs vss-extension.json --rev-version",
    "publish": "npx tfx extension publish --manifest-globs vss-extension.json",
    "deploy:org": "npm run build && npm run package && npx tfx extension publish --manifest-globs vss-extension.json",
    "setup:github": "node scripts/setup-github.js",
    "check:branch": "node scripts/check-branch-config.js",
    "validate": "npm run lint && npm run build && npm run test:local"
  },
  "keywords": [
    "azure-devops",
    "spec-driven-development",
    "ai",
    "specification",
    "planning",
    "claude",
    "gemini",
    "copilot",
    "cursor"
  ],
  "author": "Spec Kit Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^18.15.0",
    "@typescript-eslint/eslint-plugin": "^5.57.0",
    "@typescript-eslint/parser": "^5.57.0",
    "eslint": "^8.37.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "typescript": "^5.0.2",
    "webpack": "^5.76.0",
    "webpack-cli": "^5.0.1"
  },
  "dependencies": {
    "azure-devops-node-api": "^11.2.0",
    "azure-pipelines-task-lib": "^4.0.0",
    "azure-pipelines-tool-lib": "^1.0.0",
    "axios": "^1.3.4",
    "vss-web-extension-sdk": "^5.141.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
